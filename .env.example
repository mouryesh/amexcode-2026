# Copy to .env and adjust. .env is gitignored — never commit real keys.

# --- PostgreSQL: system of record + hash-chained audit ledger ------------- #
PG_DSN=postgresql://amex:amex@localhost:5432/servicing
PG_POOL_MIN=1
PG_POOL_MAX=10

# --- MongoDB: live flow state documents ----------------------------------- #
MONGO_URI=mongodb://localhost:27017
MONGO_DB=servicing

# --- Splunk: searchable audit mirror via HEC ------------------------------ #
# SPLUNK_ENABLED=false makes every ship a no-op. The agent still works and the
# Postgres chain is still authoritative — you only lose search and dashboards.
SPLUNK_ENABLED=true
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=amex-hec-token-local-dev
SPLUNK_INDEX=amex_audit
SPLUNK_SOURCETYPE=amex:agent:audit
SPLUNK_VERIFY_TLS=false
SPLUNK_TIMEOUT_S=3

# --- LLM ------------------------------------------------------------------ #
# offline | anthropic | openai | groq
LLM_PROVIDER=offline
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
